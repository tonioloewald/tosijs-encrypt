{
  "name": "tosijs-encrypt",
  "version": "1.1.0",
  "description": "A simple, zero-dependency library for generating keys, encrypting, and decrypting strings using the Web Crypto API",
  "author": "Tonio Loewald",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "encryption",
    "crypto",
    "aes",
    "aes-gcm",
    "web-crypto",
    "encrypt",
    "decrypt",
    "cryptography",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tonioloewald/tosijs-encrypt.git"
  },
  "bugs": {
    "url": "https://github.com/tonioloewald/tosijs-encrypt/issues"
  },
  "homepage": "https://github.com/tonioloewald/tosijs-encrypt#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "scripts": {
    "build": "rm -rf dist && bun build index.ts --outdir=dist && tsc -p tsconfig.build.json && bun bin/sizes.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun test && bun run build",
    "latest": "rm -rf node_modules && bun install"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "releaseDoctor": {
    "securityEntries": [
      "index.ts"
    ]
  }
}
